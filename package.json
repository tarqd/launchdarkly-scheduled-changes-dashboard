{
  "name": "launchdarkly-scheduled-changes-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "A single pane of glass for every scheduled change in a LaunchDarkly account.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:vite": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@internationalized/date": "3.12.2",
    "@launchpad-ui/components": "0.25.0",
    "@launchpad-ui/icons": "0.26.7",
    "@launchpad-ui/tokens": "0.19.0",
    "@react-aria/focus": "3.22.1",
    "@react-aria/interactions": "3.28.1",
    "@react-aria/utils": "3.34.1",
    "@react-stately/utils": "3.12.1",
    "@react-types/shared": "3.36.0",
    "react": "^19.3.0",
    "react-aria": "3.50.0",
    "react-aria-components": "1.19.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "7.59.0",
    "react-router": "8.2.0",
    "react-stately": "3.48.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@cloudflare/workers-types": "^5.20260918.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "^1.57.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.134.0"
  },
  "engines": {
    "node": ">=20"
  }
}
