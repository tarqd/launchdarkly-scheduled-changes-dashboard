{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "launchdarkly-scheduled-changes-dashboard",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    // `us` (app.launchdarkly.com) or `federal` (app.launchdarkly.us).
    "LD_INSTANCE": "us"

    // Set this to the redirect URI you registered on the OAuth client, exactly.
    // LaunchDarkly matches it character for character and allows only one per
    // client, so pinning it here beats deriving it from the request.
    // "LD_REDIRECT_URI": "https://your-worker.workers.dev/auth/callback"
  }
  // LD_CLIENT_ID, LD_CLIENT_SECRET and SESSION_SECRET are secrets:
  //   wrangler secret put LD_CLIENT_ID
  //   wrangler secret put LD_CLIENT_SECRET
  //   wrangler secret put SESSION_SECRET
}
